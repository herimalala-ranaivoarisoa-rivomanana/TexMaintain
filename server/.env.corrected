# ============================================
# DATABASE CONFIGURATION
# ============================================
# Docker MongoDB with authentication (UTILISEZ CELLE-CI)
DATABASE_URL=mongodb://root:example@localhost:27017/texmaintain?authSource=admin

# ============================================
# JWT & SESSION SECRETS
# ============================================
# IMPORTANT: Changez ces valeurs en production !
# JWT_SECRET doit faire minimum 32 caractères
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
REFRESH_TOKEN_SECRET=change_me_refresh

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# CORS CONFIGURATION
# ============================================
# Frontend URL (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# Décommentez si vous utilisez Redis pour le cache
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=5
