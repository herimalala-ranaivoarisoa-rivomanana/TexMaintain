{
  "info": {
    "name": "TexMaintain API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Content-Type","value":"application/json"}
            ],
            "url": {"raw":"{{baseUrl}}/api/auth/login","host":["{{baseUrl}}"],"path":["api","auth","login"]},
            "body": {"mode":"raw","raw":"{\n  \"email\": \"admin@texmaintain.com\",\n  \"password\": \"admin123\"\n}"}
          }
        },
        {"name":"Me","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/auth/me","host":["{{baseUrl}}"],"path":["api","auth","me"]}}},
        {"name":"Refresh","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/auth/refresh","host":["{{baseUrl}}"],"path":["api","auth","refresh"]},"body":{"mode":"raw","raw":"{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"}}},
        {"name":"Logout","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/auth/logout","host":["{{baseUrl}}"],"path":["api","auth","logout"]}}}
      ]
    },
    {
      "name": "Seed",
      "item": [
        {"name":"Seed Admin","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/seed/admin","host":["{{baseUrl}}"],"path":["api","seed","admin"]}}},
        {"name":"Seed Equipment","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/seed/equipment-types","host":["{{baseUrl}}"],"path":["api","seed","equipment-types"]}}},
        {"name":"Seed Parts","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/seed/parts","host":["{{baseUrl}}"],"path":["api","seed","parts"]}}}
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {"name":"List","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/equipment","host":["{{baseUrl}}"],"path":["api","equipment"]}}},
        {"name":"Create","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/equipment","host":["{{baseUrl}}"],"path":["api","equipment"]},"body":{"mode":"raw","raw":"{\n  \"name\": \"Test Machine\",\n  \"type\": \"spinning\",\n  \"status\": \"operational\",\n  \"location\": \"Line 1\"\n}"}}},
        {"name":"Get by id","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/equipment/{{equipmentId}}","host":["{{baseUrl}}"],"path":["api","equipment","{{equipmentId}}"]}}},
        {"name":"Update","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/equipment/{{equipmentId}}","host":["{{baseUrl}}"],"path":["api","equipment","{{equipmentId}}"]},"body":{"mode":"raw","raw":"{\n  \"status\": \"maintenance\"\n}"}}},
        {"name":"Delete","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/equipment/{{equipmentId}}","host":["{{baseUrl}}"],"path":["api","equipment","{{equipmentId}}"]}}}
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {"name":"List","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/inventory","host":["{{baseUrl}}"],"path":["api","inventory"]}}},
        {"name":"Create","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/inventory","host":["{{baseUrl}}"],"path":["api","inventory"]},"body":{"mode":"raw","raw":"{\n  \"name\": \"V-Belt Type A\",\n  \"partNumber\": \"VB-A-001\",\n  \"category\": \"Belts\"\n}"}}},
        {"name":"Update stock","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/inventory/{{partId}}/stock","host":["{{baseUrl}}"],"path":["api","inventory","{{partId}}","stock"]},"body":{"mode":"raw","raw":"{\n  \"quantity\": 5,\n  \"type\": \"in\"\n}"}}},
        {"name":"Update","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/inventory/{{partId}}","host":["{{baseUrl}}"],"path":["api","inventory","{{partId}}"]},"body":{"mode":"raw","raw":"{\n  \"minStock\": 12\n}"}}},
        {"name":"Delete","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/inventory/{{partId}}","host":["{{baseUrl}}"],"path":["api","inventory","{{partId}}"]}}}
      ]
    },
    {
      "name": "Interventions",
      "item": [
        {"name":"List","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/interventions","host":["{{baseUrl}}"],"path":["api","interventions"]}}},
        {"name":"Create","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/interventions","host":["{{baseUrl}}"],"path":["api","interventions"]},"body":{"mode":"raw","raw":"{\n  \"title\": \"Belt Replacement\",\n  \"type\": \"Corrective\",\n  \"priority\": \"High\",\n  \"equipment\": \"Spinning Machine A1\"\n}"}}},
        {"name":"Update","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/interventions/{{interventionId}}","host":["{{baseUrl}}"],"path":["api","interventions","{{interventionId}}"]},"body":{"mode":"raw","raw":"{\n  \"status\": \"In Progress\"\n}"}}},
        {"name":"Delete","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":{"raw":"{{baseUrl}}/api/interventions/{{interventionId}}","host":["{{baseUrl}}"],"path":["api","interventions","{{interventionId}}"]}}}
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:3000"},
    {"key": "accessToken", "value": ""},
    {"key": "refreshToken", "value": ""},
    {"key": "equipmentId", "value": ""},
    {"key": "partId", "value": ""},
    {"key": "interventionId", "value": ""}
  ]
